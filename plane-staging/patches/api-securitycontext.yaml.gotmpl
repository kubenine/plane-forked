apiVersion: apps/v1
kind: Deployment
metadata:
  name: plane-api-wl
  namespace: {{ requiredEnv "NAMESPACE" }}
spec:
  template:
    metadata:
      labels:
        app.kubernetes.io/part-of: plane
    spec:
      securityContext:
        runAsNonRoot: true
        runAsUser: 1000
        seccompProfile:
          type: RuntimeDefault
      containers:
        - name: plane-api
          securityContext:
            allowPrivilegeEscalation: false
          # Chart already hardcodes a readinessProbe (GET / :8000, workloads/
          # api.deployment.yaml) — no livenessProbe anywhere, added here to match.
          livenessProbe:
            httpGet:
              path: /
              port: 8000
            initialDelaySeconds: 30
            periodSeconds: 20
            failureThreshold: 3
