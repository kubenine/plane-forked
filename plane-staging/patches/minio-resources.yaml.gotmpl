
apiVersion: apps/v1
kind: StatefulSet
metadata:
  name: plane-minio-wl
  namespace: {{ requiredEnv "NAMESPACE" }}
spec:
  template:
    spec:
      containers:
        - name: plane-minio
          resources:
            requests:
              cpu: 100m
              memory: 256Mi
            limits:
              cpu: 300m
              memory: 512Mi
