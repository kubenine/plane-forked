apiVersion: apps/v1
kind: Deployment
metadata:
  name: plane-space-wl
  namespace: {{ requiredEnv "NAMESPACE" }}
spec:
  template:
    metadata:
      labels:
        app.kubernetes.io/part-of: plane
    spec:
      securityContext:
        runAsNonRoot: true
        runAsUser: 1000
        fsGroup: 1000
        seccompProfile:
          type: RuntimeDefault
      volumes:
        - name: nginx-cache
          emptyDir: {}
        - name: nginx-run
          emptyDir: {}
      containers:
        - name: plane-space
          securityContext:
            allowPrivilegeEscalation: false
          # Matches the Dockerfile's own HEALTHCHECK (apps/space/Dockerfile.space) — the
          # app is mounted under /spaces, not /, so root would 404.
          readinessProbe:
            httpGet:
              path: /spaces/
              port: 3000
            periodSeconds: 10
            failureThreshold: 3
          livenessProbe:
            httpGet:
              path: /spaces/
              port: 3000
            initialDelaySeconds: 10
            periodSeconds: 20
            failureThreshold: 3
          volumeMounts:
            - name: nginx-cache
              mountPath: /var/cache/nginx
            - name: nginx-run
              mountPath: /var/run
