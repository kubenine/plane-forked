apiVersion: apps/v1
kind: Deployment
metadata:
  name: plane-live-wl
  namespace: {{ requiredEnv "NAMESPACE" }}
spec:
  template:
    metadata:
      labels:
        app.kubernetes.io/part-of: plane
    spec:
      securityContext:
        runAsNonRoot: true
        runAsUser: 1000
        seccompProfile:
          type: RuntimeDefault
      containers:
        - name: plane-live
          securityContext:
            allowPrivilegeEscalation: false
          # apps/live/src/controllers/health.controller.ts exposes a real GET /health
          # route (@Controller("/health")), but apps/live/src/server.ts mounts the
          # whole router under env.LIVE_BASE_PATH (default "/live") — actual path is
          # /live/health, not /health.
          readinessProbe:
            httpGet:
              path: /live/health
              port: 3000
            periodSeconds: 10
            failureThreshold: 3
          livenessProbe:
            httpGet:
              path: /live/health
              port: 3000
            initialDelaySeconds: 10
            periodSeconds: 20
            failureThreshold: 3
